# --- Sample data -------------------------------------------------------
# Big, regenerable or re-downloadable, and not source. DRR325755.btop alone
# is ~985 MB, well over GitHub's 100 MB per-file limit.
*.btop
*.gb
*.gbk
*.fa
*.fasta
*.fastq
*.fq
*.gz
olesdata/

# ...except the bundled example (see examples/README.md). Named file by file,
# not `!examples/`, so that anything a run writes into examples/ with -o stays
# ignored. A '!' line re-includes only if it comes after the rule it overrides.
!/examples/AP027148.gb.gz
!/examples/DRR325755_20x.btop.gz

# --- Generated output --------------------------------------------------
*.pdf
*.readriftdb.npz
# Caches written before the rename to ReadRift. Note: .gitignore has no inline
# comments - a '#' is only a comment at the start of a line, so this one gets
# its own line or it becomes part of the pattern above and matches nothing.
*.readmapdb.npz
*_Analysis.tsv
extract-reads-list_*

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Editors / OS ------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- Local, not project ------------------------------------------------
# Per-machine tool permissions, and personal scratch notes. CLAUDE.md is
# tracked (it is project instructions); this file is one user's settings.
.claude/settings.local.json
Lars_Hints.txt

# To keep an ignored file anyway (e.g. a small reference you want tracked):
#   git add -f AP027148.gb
